    },
    {
      "from": "s8b",
      "to": "g6",
      "logic": "INITCAP(MCC_DESC)"
    },
    {
      "from": "s9",
      "to": "g7",
      "logic": "Latest per TXN_ID · QUALIFY ROW_NUMBER() OVER (PARTITION BY TXN_ID ORDER BY SCORED_AT DESC) = 1"
    },
