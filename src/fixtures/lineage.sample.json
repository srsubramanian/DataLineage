      "to": "g2c",
      "logic": "Direct"
    },
    {
      "from": "s4",
      "to": "g3",
      "logic": "DECODE: PS→POSTED · PD→PENDING · RV→REVERSED · DC→DECLINED"
    },
    {
      "from": "s5",
      "to": "g4",
      "logic": "CONVERT_TIMEZONE('UTC', POSTED_TS) → ISO-8601"
    },
    {
      "from": "s6",
      "to": "g5",
      "logic": "JOIN CORE.DIM_MERCHANT USING (MERCHANT_ID)"
    },
    {
      "from": "s7",
      "to": "g5",
